.env.*.local

# Docker
Dockerfile*
docker-compose*.yml
.dockerignore

# Infrastructure
infrastructure/

# Scripts
scripts/

# Tests
# tests/e2e is a go.work member: its go.mod/go.sum must stay in the build context, or `go build`
# fails resolving the workspace even for services that do not depend on it. Only the parts of
# tests/ nothing needs to build an image are excluded here.
tests/performance/
tests/e2e/*_test.go
*_test.go
test_*.py
services/*/tests/
**/migrations/

# Development tools
Makefile

# Exclude other services from builds (will be overridden during specific service builds)
!services/*/
!shared/
