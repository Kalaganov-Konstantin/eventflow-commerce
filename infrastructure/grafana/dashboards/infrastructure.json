{
  "title": "Infrastructure",
  "uid": "eventflow-infrastructure",
  "tags": ["eventflow-commerce", "infrastructure"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Exporters reachable",
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "pg_up",
          "legendFormat": "postgres"
        },
        {
          "refId": "B",
          "expr": "redis_up",
          "legendFormat": "redis"
        },
        {
          "refId": "C",
          "expr": "kafka_brokers",
          "legendFormat": "kafka brokers"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Postgres: backends per database",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "pg_stat_database_numbackends{datname=~\"orders|payments|inventory|notifications\"}",
          "legendFormat": "{{datname}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Postgres: commits and rollbacks",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (datname) (rate(pg_stat_database_xact_commit{datname=~\"orders|payments|inventory|notifications\"}[$__rate_interval]))",
          "legendFormat": "{{datname}} commit"
        },
        {
          "refId": "B",
          "expr": "sum by (datname) (rate(pg_stat_database_xact_rollback{datname=~\"orders|payments|inventory|notifications\"}[$__rate_interval]))",
          "legendFormat": "{{datname}} rollback"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Postgres: buffer cache hit ratio",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (datname) (rate(pg_stat_database_blks_hit{datname=~\"orders|payments|inventory|notifications\"}[$__rate_interval])) / clamp_min(sum by (datname) (rate(pg_stat_database_blks_hit{datname=~\"orders|payments|inventory|notifications\"}[$__rate_interval]) + rate(pg_stat_database_blks_read{datname=~\"orders|payments|inventory|notifications\"}[$__rate_interval])), 1)",
          "legendFormat": "{{datname}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Postgres: database size",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "pg_database_size_bytes{datname=~\"orders|payments|inventory|notifications\"}",
          "legendFormat": "{{datname}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Postgres: longest running transaction",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "max(pg_stat_activity_max_tx_duration)",
          "legendFormat": "longest transaction"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Redis: memory used against the configured ceiling",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "redis_memory_used_bytes",
          "legendFormat": "used"
        },
        {
          "refId": "B",
          "expr": "redis_memory_max_bytes",
          "legendFormat": "maxmemory"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Redis: keyspace hit ratio",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 28 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(redis_keyspace_hits_total[$__rate_interval]) / clamp_min(rate(redis_keyspace_hits_total[$__rate_interval]) + rate(redis_keyspace_misses_total[$__rate_interval]), 1)",
          "legendFormat": "hit ratio"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Redis: commands, clients and evictions",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 28 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(redis_commands_processed_total[$__rate_interval])",
          "legendFormat": "commands per second"
        },
        {
          "refId": "B",
          "expr": "redis_connected_clients",
          "legendFormat": "connected clients"
        },
        {
          "refId": "C",
          "expr": "rate(redis_evicted_keys_total[$__rate_interval])",
          "legendFormat": "evicted keys per second"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Redis: keys held",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 36 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (db) (redis_db_keys) > 0",
          "legendFormat": "{{db}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Kafka: consumer group lag",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 36 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (consumergroup, topic) (kafka_consumergroup_lag_sum)",
          "legendFormat": "{{consumergroup}} / {{topic}}"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Kafka: messages written per topic",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 44 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (topic) (rate(kafka_topic_partition_current_offset{topic!~\"__.*\"}[$__rate_interval]))",
          "legendFormat": "{{topic}}"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Kafka: under replicated partitions",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 44 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (topic) (kafka_topic_partition_under_replicated_partition{topic!~\"__.*\"})",
          "legendFormat": "{{topic}}"
        }
      ]
    }
  ]
}
