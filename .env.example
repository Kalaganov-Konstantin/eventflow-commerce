# =============================================================================
# EventFlow Commerce - Environment Configuration
# =============================================================================
# Copy this file to .env and adjust the values as needed

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
DATABASE_URL=postgres://postgres:postgres@postgres:5432/eventflow
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=eventflow

# Service-specific Database URLs
ORDER_DATABASE_URL=postgres://orders_user:orders_pass@postgres:5432/orders?sslmode=disable
PAYMENT_DATABASE_URL=postgres://payments_user:payments_pass@postgres:5432/payments?sslmode=disable
INVENTORY_DATABASE_URL=postgres://inventory_user:inventory_pass@postgres:5432/inventory?sslmode=disable
NOTIFICATION_DATABASE_URL=postgres://notifications_user:notifications_pass@postgres:5432/notifications

# =============================================================================
# CACHE CONFIGURATION
# =============================================================================
REDIS_URL=redis://redis:6379

# =============================================================================
# MESSAGE BROKER CONFIGURATION
# =============================================================================
KAFKA_BROKERS=kafka:9092
KAFKA_CONSUMER_GROUP=eventflow-commerce

# Per-service consumer groups and dead letter queue topics.
# These match the defaults compiled into each service, listed here for visibility.
ORDER_KAFKA_GROUP_ID=order-service
ORDER_KAFKA_DLQ_TOPIC=orders.events.dlq
PAYMENT_KAFKA_GROUP_ID=payment-service
PAYMENT_KAFKA_DLQ_TOPIC=payments.events.dlq
INVENTORY_KAFKA_GROUP_ID=inventory-service
INVENTORY_KAFKA_DLQ_TOPIC=inventory.events.dlq

# =============================================================================
# OBSERVABILITY CONFIGURATION
# =============================================================================
# The otel jaeger exporter no longer exists; traces go out as OTLP over HTTP,
# which jaeger accepts natively on its collector endpoint.
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
PROMETHEUS_ENDPOINT=http://prometheus:9090

# =============================================================================
# SERVICE URLS (Internal Communication)
# =============================================================================
ORDER_SERVICE_URL=http://order-service:8081
PAYMENT_SERVICE_URL=http://payment-service:8082
INVENTORY_SERVICE_URL=http://inventory-service:8083
NOTIFICATION_SERVICE_URL=http://notification-service:8084

# =============================================================================
# SERVICE PORTS
# =============================================================================
# *_SERVICE_PORT here is only the interpolation source for docker-compose.yml.
# Compose maps each one to the *_SERVER_PORT variable that actually lands
# inside the container and that services bind to (with *_SERVICE_PORT kept
# as a fallback name for backward compatibility).
API_GATEWAY_PORT=8080
ORDER_SERVICE_PORT=8081
PAYMENT_SERVICE_PORT=8082
INVENTORY_SERVICE_PORT=8083
NOTIFICATION_SERVICE_PORT=8084

# Infrastructure Ports
POSTGRES_PORT=5432
REDIS_PORT=6379
KAFKA_PORT=9092
KAFKA_JMX_PORT=9999
ZOOKEEPER_PORT=2181
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
ALERTMANAGER_PORT=9093
WEBHOOK_LOGGER_PORT=8085
JAEGER_UI_PORT=16686
JAEGER_ZIPKIN_PORT=9411
JAEGER_JAEGER_BINARY_PORT=14250
JAEGER_JAEGER_THRIFT_PORT=14268
JAEGER_AGENT_ZIPKIN_PORT=5775
JAEGER_AGENT_COMPACT_PORT=6831
JAEGER_AGENT_BINARY_PORT=6832
JAEGER_ADMIN_PORT=5778
JAEGER_OTLP_GRPC_PORT=4317
JAEGER_OTLP_HTTP_PORT=4318
KAFKA_UI_PORT=8090

# Logging stack (elasticsearch, kibana, fluentd), behind the compose "logging" profile so
# make demo does not start it by default; bring it up with make logging-up.
ELASTICSEARCH_PORT=9200
KIBANA_PORT=5601

# Exporter Ports (feed postgres and redis stats to Prometheus, neither speaks its format natively)
POSTGRES_EXPORTER_PORT=9187
REDIS_EXPORTER_PORT=9121
KAFKA_EXPORTER_PORT=9308

# Kafka UI Configuration
KAFKA_UI_CLUSTER_NAME=eventflow-cluster

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
# Environment: development, staging, production. The Go services switch to json logs through
# their own *_LOGGER_ENVIRONMENT variable; this one drives the notification service's json
# formatter, which stays off in development so local logs remain human-readable.
ENVIRONMENT=development

# =============================================================================
# RATE LIMITING
# =============================================================================
# Requests per minute the gateway allows per client IP. The burst size is derived from this
# value, so lowering it also shrinks the tolerated spike. `make test-performance` overrides it
# for the duration of the run, since k6 drives the whole scenario from a single address.
API_GATEWAY_RATE_LIMIT_RPM=100

# =============================================================================
# SERVICE DISCOVERY
# =============================================================================
API_GATEWAY_SERVICE_NAME=api-gateway
API_GATEWAY_SERVICE_VERSION=1.0.0

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
# Logging level: debug, info, warn, error
API_GATEWAY_LOGGER_LEVEL=info
API_GATEWAY_LOGGER_ENVIRONMENT=development
API_GATEWAY_LOGGER_OUTPUT_PATHS=stdout

# =============================================================================
# SECURITY
# =============================================================================
# Security - IMPORTANT: Generate a strong secret key for production!
# Use: openssl rand -base64 32
JWT_SECRET=CHANGE_ME_IN_PRODUCTION_GENERATE_WITH_openssl_rand_base64_32
API_KEY=your-api-key-here

# =============================================================================
# EXTERNAL SERVICES (Optional)
# =============================================================================
# Email service configuration
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Payment gateway configuration
PAYMENT_GATEWAY_URL=
PAYMENT_GATEWAY_API_KEY=

# =============================================================================
# MONITORING CONFIGURATION
# =============================================================================
GRAFANA_ADMIN_PASSWORD=admin
PROMETHEUS_RETENTION_TIME=15d
